#!/usr/bin/env bash
# packages.list: {{ include "packages.list" | sha256sum }}
set -euo pipefail
if [[ "${PREFIX:-}" != /data/data/com.termux/files/usr ]] || ! command -v pkg >/dev/null; then
  echo 'Package installation requires Termux.' >&2
  exit 1
fi
mapfile -t packages < <(sed -E 's/#.*//; /^[[:space:]]*$/d' {{ joinPath .chezmoi.sourceDir "packages.list" | quote }})
pkg update -y
pkg install -y "${packages[@]}"
