#!/usr/bin/env bash
set -euo pipefail
source_dir={{ .chezmoi.sourceDir | quote }}
dest_dir={{ .chezmoi.destDir | quote }}
backup_root="$dest_dir/.local/state/dotfiles/backups/$(date -u +%Y%m%dT%H%M%S)-$$"
scratch="$(mktemp -d)"
trap 'rm -rf -- "$scratch"' EXIT

backup_move() {
  local target="$1" relative="${1#"$dest_dir/"}"
  mkdir -p "$backup_root/files/$(dirname "$relative")"
  mv -- "$target" "$backup_root/files/$relative"
  printf '%s\n' "$relative" >> "$backup_root/paths.txt"
  printf 'Backed up %s to %s\n' "$target" "$backup_root/files/$relative"
}

chezmoi --source "$source_dir" --destination "$dest_dir" managed --include dirs --path-style absolute > "$scratch/dirs"
while IFS= read -r target; do
  if [[ -L "$target" || ( -e "$target" && ! -d "$target" ) ]]; then
    backup_move "$target"
  fi
done < "$scratch/dirs"

chezmoi --source "$source_dir" --destination "$dest_dir" managed --include files --path-style absolute > "$scratch/files"
while IFS= read -r target; do
  [[ -e "$target" || -L "$target" ]] || continue
  chezmoi --source "$source_dir" --destination "$dest_dir" cat --output "$scratch/desired" "$target"
  if [[ -L "$target" || ! -f "$target" ]] || ! cmp -s "$scratch/desired" "$target"; then
    backup_move "$target"
  fi
done < "$scratch/files"
